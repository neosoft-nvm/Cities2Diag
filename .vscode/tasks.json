{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/Cities2Diag.sln", "-c", "Debug"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "build release",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/Cities2Diag.sln", "-c", "Release"],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}
